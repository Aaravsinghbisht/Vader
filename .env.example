# ── Vader local configuration ─────────────────────────────────────────────
# Copy to .env and adjust as needed. All values are optional; the app has
# sensible defaults for every one of them.

# Ollama OpenAI-compatible endpoint consumed by the Eve agent layer.
# In docker-compose, this is rewritten to http://ollama:11434/v1 automatically.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Local LLM model used for follow-up Q&A (attach + `ollama pull <model>`).
OLLAMA_MODEL=lfm2.5

# Road/OSM search radius in kilometres (1–25). Larger = slower Overpass queries.
BRIEFING_RADIUS_KM=5

# Timeout (ms) for DuckDuckGo searches and page enrichment fetches.
WEB_FETCH_TIMEOUT_MS=12000

# Next.js server port (used by `npm run dev` / `next start` / standalone image).
PORT=3000